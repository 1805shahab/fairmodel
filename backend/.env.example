APP_ENV=development
DATABASE_URL=sqlite:///./fairmodel.db
STORAGE_DIR=./storage
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Paid-tier Gemini voice replication; opt in after reviewing consent and provider costs.
ENABLE_VOICE_GENERATION=false
GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# Explicit Voices creation model, independent of the speech synthesis model above.
GEMINI_VOICE_REPLICATION_MODEL=gemini-3.8-flash-tts
# Additional provider; only the free model is accepted. Separate artist grant required.
FISH_API_KEY=
FISH_TTS_MODEL=s2.1-pro-free
ENABLE_FISH_GENERATION=false
GROQ_API_KEY=
GROQ_WHISPER_MODEL=whisper-large-v3-turbo
PAYMENT_PROVIDER=mock
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_WEBHOOK_ID=
PAYPAL_SANDBOX_MERCHANT_EMAIL=
PAYPAL_SANDBOX_BUYER_EMAIL=
# Enable only for deliberately authorized Sandbox actions; startup never creates invoices.
PAYPAL_ALLOW_DRAFTS=false
PAYPAL_ALLOW_SENDING=false
ENABLE_SPEAKER_VERIFICATION=false
DEMO_MODE=true
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
FRONTEND_ORIGIN=http://localhost:3000
MAX_UPLOAD_MB=24
MAX_AUDIO_SECONDS=600
